generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Compania {
  ATT
  MOVISTAR
  BAIT
}

enum EstadoSolicitud {
  RECIBIDA
  REVISION_PAGO
  PAGO_RECHAZADO
  PAGO_VALIDADO
  EN_ACTIVACION
  QR_ENVIADO
  ACTIVADA
  CANCELADA
}

enum RolAdmin {
  PRO
  GENERAL
  RECARGAS
}

enum MetodoPago {
  TRANSFERENCIA
  STRIPE
}

// A qué flujo pertenece una cuenta bancaria. Las cuentas de recargas son
// distintas a las de eSIM y nunca se muestran en el checkout de eSIM.
enum DestinoCuenta {
  ESIM
  RECARGAS
}

// Flujo del registro de negocios para la plataforma de recargas. Más corto
// que el de eSIM: no hay activación en sistema de compañía ni QR, se
// entregan usuario + contraseña genérica.
enum EstadoRegistro {
  RECIBIDO
  REVISION_PAGO
  PAGO_RECHAZADO
  PAGO_VALIDADO
  CREDENCIALES_ENVIADAS
  CANCELADO
}

model Plan {
  id          Int         @id @default(autoincrement())
  compania    Compania
  precio      Decimal     @db.Decimal(10, 2)
  recarga     Decimal     @db.Decimal(10, 2)
  megas       Int?
  dias        Int?
  descripcion String?
  activo      Boolean     @default(true)
  destacado   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  solicitudes Solicitud[]
}

model Solicitud {
  id          Int             @id @default(autoincrement())
  // Folio público (nanoid, prefijo "MT-"). Sustituye a `id` en toda
  // superficie expuesta a usuarios anónimos (emails, /gracias, consulta de
  // estado) — `id` se conserva solo para las rutas del panel admin
  // (autenticadas). NOT NULL desde la migración add_public_code_not_null,
  // aplicada después del backfill de datos existentes.
  publicCode  String          @unique
  nombre      String
  email       String
  telefono    String?
  ciudad      String?
  estadoMx    String?
  lada        String?
  compania    Compania
  planId      Int
  plan        Plan            @relation(fields: [planId], references: [id])
  // Requerido a nivel de aplicación cuando metodoPago = TRANSFERENCIA (ver
  // zod schema en routes/solicitudes.ts) — nullable aquí porque Stripe no
  // sube comprobante.
  comprobante String?
  metodoPago  MetodoPago      @default(TRANSFERENCIA)
  estado      EstadoSolicitud @default(RECIBIDA)
  observacion String?
  qrUrl       String?
  dn          String?

  // --- Campos específicos del flujo Stripe ---
  // Precio congelado en centavos al crear el Checkout Session. El webhook
  // compara el monto cobrado contra este valor, no contra el precio vivo del
  // plan, para no mandar a revisión una venta legítima si el admin edita el
  // precio del plan entre que el cliente abre el checkout y paga.
  precioCotizado       Int?
  // Identificador de correlación con el Checkout Session de Stripe. Se
  // escribe tanto si el monto coincide como si no — es un identificador de
  // correlación, no una marca de pago exitoso.
  stripeSessionId      String?   @unique
  // Token opaco de un solo propósito: aterrizaje inmediato en /gracias tras
  // el redirect de Stripe. Expira a las 48h; pasado ese tiempo el cliente usa
  // la consulta general por folio + correo.
  accessToken          String?   @unique
  accessTokenExpiresAt DateTime?
  // Evidencia para contracargos — solo se captura en el flujo Stripe.
  ip                   String?
  userAgent            String?

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  historial HistorialEstado[]
}

// Registro de eventos de webhook de Stripe procesados, para idempotencia.
// `id` es el event.id que manda Stripe (no se genera nada propio) — el
// constraint único de la PK es lo que evita procesar el mismo evento dos
// veces ante reintentos o entregas concurrentes.
model StripeEvent {
  id          String    @id
  type        String
  // null = fila insertada pero el procesamiento no terminó (crash a medias,
  // o en curso). Distinción explícita de "existe la fila" vs "se completó" —
  // la deduplicación se evalúa sobre este campo, no sobre la existencia de
  // la fila.
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model HistorialEstado {
  id             Int             @id @default(autoincrement())
  solicitudId    Int
  solicitud      Solicitud       @relation(fields: [solicitudId], references: [id])
  estadoAnterior EstadoSolicitud
  estadoNuevo    EstadoSolicitud
  adminId        Int?
  admin          Admin?          @relation(fields: [adminId], references: [id])
  observacion    String?
  createdAt      DateTime        @default(now())
}

model CuentaBancaria {
  id      Int           @id @default(autoincrement())
  banco   String
  titular String
  cuenta  String?
  clabe   String?
  activo  Boolean       @default(true)
  orden   Int           @default(0)
  destino DestinoCuenta @default(ESIM)
}

// Registro de un negocio que quiere vender recargas con la plataforma de
// MEGATAE. Tabla propia (no reutiliza Solicitud) porque no tiene compañía,
// plan ni LADA. La contraseña entregada NO se guarda — viaja solo en el
// correo de credenciales (ver docs/ARCHITECTURE.md, sección 17).
model RegistroRecargas {
  id                     Int                         @id @default(autoincrement())
  // Folio público, prefijo "RR-" (mismo alfabeto que el folio de eSIM).
  publicCode             String                      @unique
  nombreCompleto         String
  email                  String
  telefono               String
  nombreNegocio          String
  // Clave del catálogo GIROS_NEGOCIO (lib/giros.ts). Se valida en la API, no
  // con un enum de Postgres, para poder agregar opciones sin migración.
  giro                   String
  // Solo cuando giro = "OTRO".
  giroOtro               String?
  comprobante            String
  // Capturado por mesa de control al validar; debe ser >= monto mínimo.
  montoValidado          Decimal?                    @db.Decimal(10, 2)
  estado                 EstadoRegistro              @default(RECIBIDO)
  observacion            String?
  usuarioPlataforma      String?
  credencialesEnviadasAt DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  historial              HistorialRegistroRecargas[]

  @@index([estado])
}

model HistorialRegistroRecargas {
  id             Int              @id @default(autoincrement())
  registroId     Int
  registro       RegistroRecargas @relation(fields: [registroId], references: [id])
  estadoAnterior EstadoRegistro
  estadoNuevo    EstadoRegistro
  adminId        Int?
  admin          Admin?           @relation(fields: [adminId], references: [id])
  observacion    String?
  createdAt      DateTime         @default(now())

  @@index([registroId])
}

model Lead {
  id             Int      @id @default(autoincrement())
  email          String
  aceptoTerminos Boolean
  createdAt      DateTime @default(now())
}

model Admin {
  id                 Int                         @id @default(autoincrement())
  email              String                      @unique
  passwordHash       String
  nombre             String
  rol                RolAdmin
  activo             Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  historial          HistorialEstado[]
  historialRegistros HistorialRegistroRecargas[]
}
